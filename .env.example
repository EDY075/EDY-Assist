# EDY Assist — configuração local segura
NODE_ENV=development
HOST=127.0.0.1
PORT=3333
DATABASE_URL="file:./prisma/dev.db"
APP_TIMEZONE=America/Sao_Paulo
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Provedor ativo: mock (simulador local), meta ou twilio.
WHATSAPP_PROVIDER=mock

# Integração oficial da Meta — deixe vazio para usar o modo local.
# Nunca grave valores reais neste arquivo nem os envie ao controle de versão.
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0

# Twilio Sandbox / WhatsApp — deixe vazio no arquivo de exemplo.
# A URL de webhook deve ser HTTPS e incluir o caminho completo.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
TWILIO_WEBHOOK_URL=
# Opcional: modelo oficial exigido pela experiência One Console Trial para respostas REST.
TWILIO_CONTENT_SID=

# O frontend usa /api por padrão e o Vite encaminha as chamadas à API local.
VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:3333
